# Copy to .env before running docker compose -f docker-compose.prod.yml up --build
AWS_REGION=ap-southeast-1
JWT_KEY=replace-with-strong-secret
REDIS_URL=rediss://<elasticache-endpoint>:6379

# SQS queue URLs (created by infrastructure repo: ticket-selling-keda)
SQS_AUTH_QUEUE_URL=
SQS_CLIENT_QUEUE_URL=
SQS_TICKETS_QUEUE_URL=
SQS_ORDER_EVENTS_QUEUE_URL=
SQS_ORDERS_SERVICE_QUEUE_URL=
SQS_PAYMENT_EVENTS_QUEUE_URL=
SQS_EXPIRATION_QUEUE_URL=
SQS_EXPIRATION_EVENTS_QUEUE_URL=

# Worker toggles
ENABLE_AUTH_WORKER=true
ENABLE_CLIENT_WORKER=true
ENABLE_TICKETS_WORKER=true
ENABLE_ORDERS_WORKER=true
ENABLE_SQS_CONSUMER=true
ENABLE_EXPIRATION_WORKER=true

# Orders behavior
EXPIRATION_DELAY_SECONDS=60
